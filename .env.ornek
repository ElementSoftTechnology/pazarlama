# Bu dosyayı `.env.local` adıyla kopyalayın ve doldurun. `.env.local` depoya girmez.

# Apify — TEK HESAP (koşullar §4.3: kişi başına birden fazla hesap yasak).
# Apify Console → Settings → API & Integrations → Personal API token
APIFY_TOKEN=

# Bir çalıştırmada harcanabilecek en çok dolar (her araç ayrıca kendi sınırını koyar).
# Ücretsiz plan ayda 5 $; haftalık rapor ayda yaklaşık 3-4 $ tutar.
APIFY_CALISTIRMA_SINIRI_USD=1.5

# E-posta gönderimi (npm run eposta-gonder). Google hesabı → Güvenlik → 2 adımlı doğrulama açık →
# Uygulama şifreleri → 16 haneli şifre. Boşluklu yazılabilir. Sohbete, panele ya da depoya yazılmaz.
SMTP_KULLANICI=iletisim@elementsoftechnology.com
SMTP_UYGULAMA_SIFRESI=
# E-posta ve WhatsApp metinlerinin imzasındaki ad
ULASIM_IMZA_AD=

# --- Faz 2 (henüz kullanılmıyor) ---
# Meta Marketing API, yalnız okuma (ads_read). Business Manager → Sistem Kullanıcıları.
META_ERISIM_JETONU=
META_REKLAM_HESABI=act_
# Cloudflare Web Analytics okuma: hesap düzeyinde "Account Analytics: Read" yetkili jeton
CLOUDFLARE_JETONU=
CLOUDFLARE_HESAP_KIMLIGI=
